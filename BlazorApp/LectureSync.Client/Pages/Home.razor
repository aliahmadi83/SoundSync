@page "/"
@inject IJSRuntime JS
@inject HttpClient Http
@implements IAsyncDisposable

<div class="layout" dir="rtl" lang="fa">

    <aside class="sidebar">
        <h3>سخنرانی‌ها</h3>

        <div class="upload-box">
            <label for="folderInput" class="folder-btn @(isLoading ? "disabled" : "")">
                📁 انتخاب پوشه سخنرانی‌ها
            </label>
            <InputFile id="folderInput" style="display:none"
                       OnChange="OnFolderSelected"
                       AdditionalAttributes="folderAttrs" />
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <p class="status @(isError ? "error" : "")">@statusMessage</p>
        }

        @if (lectures.Count > 0)
        {
            <ul class="lecture-list">
                @foreach (var l in lectures)
                {
                    <li class="@(l.Id == activeLectureId ? "active" : "")"
                        @onclick="() => SelectLecture(l)">
                        @l.Title
                    </li>
                }
            </ul>
        }
    </aside>

    <main class="main-content">
        <h2>پخش هم‌زمان صوت و متن</h2>

        <div class="player-wrap">
            <audio id="audioPlayer" controls></audio>
        </div>

        @if (segments.Count > 0)
        {
            <div class="transcript">
                @foreach (var s in segments)
                {
                    <span class="sentence @(s.Id == activeId ? "active" : "")"
                          @onclick="() => OnSegmentClick(s)">
                        @s.Text
                    </span>
                }
            </div>
        }
        else
        {
            <p class="hint">پوشه‌ی اصلی سخنرانی‌ها را انتخاب کنید؛ سپس یک سخنرانی را از لیست سمت راست باز کنید.</p>
        }
    </main>

</div>

@code {
    private static readonly Regex LineRegex = new(
        @"^\[\s*(\d{1,2}(?::\d{2}){1,2})\s*-\s*(\d{1,2}(?::\d{2}){1,2})\s*\]\s*(.*)$",
        RegexOptions.Compiled);

    private readonly Dictionary<string, object> folderAttrs = new()
    {
        { "webkitdirectory", true },
        { "multiple", true }
    };

    private List<Lecture> lectures = new();
    private int? activeLectureId;
    private List<Segment> segments = new();
    private int activeId = -1;

    private int nextLectureId = 1;
    private string statusMessage = "";
    private bool isError;
    private bool isLoading;
    private DotNetObjectReference<Home>? dotNetRef;

    protected override void OnInitialized() => dotNetRef = DotNetObjectReference.Create(this);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("lectureSync.initTimeUpdate", "audioPlayer", dotNetRef);
            await TryLoadSampleLecture();
        }
    }

    private async Task TryLoadSampleLecture()
    {
        try
        {
            var text = await Http.GetStringAsync("sample/lecture.txt");
            var sampleSegments = ParseTimedText(text);
            if (sampleSegments.Count > 0)
            {
                var lecture = new Lecture(nextLectureId++, "سخنرانی نمونه", "sample/lecture.mp3", sampleSegments);
                lectures.Add(lecture);
                await SelectLecture(lecture);
                StateHasChanged();
            }
        }
        catch
        {
            // فایل نمونه موجود نیست؛ مشکلی نیست
        }
    }

    // --- انتخاب پوشه‌ی اصلی ---
    private async Task OnFolderSelected(InputFileChangeEventArgs e)
    {
        isLoading = true;
        SetStatus("در حال خواندن پوشه‌ها...", false);
        StateHasChanged();

        try
        {
            var items = await JS.InvokeAsync<List<FolderLecture>>("lectureSync.readFolder", "folderInput");

            var loaded = new List<Lecture>();
            int skipped = 0;

            foreach (var item in items)
            {
                var segs = ParseTimedText(item.Text ?? "");
                if (segs.Count == 0 || string.IsNullOrEmpty(item.AudioUrl))
                {
                    skipped++;
                    continue;
                }
                loaded.Add(new Lecture(nextLectureId++, item.Title, item.AudioUrl, segs));
            }

            if (loaded.Count == 0)
            {
                SetStatus("در این پوشه هیچ سخنرانی معتبری (mp3 + txt زمان‌بندی‌شده) پیدا نشد.", true);
                return;
            }

            lectures = loaded;
            segments = new();
            activeLectureId = null;
            activeId = -1;

            SetStatus($"{loaded.Count} سخنرانی بارگذاری شد" +
                      (skipped > 0 ? $" ({skipped} پوشه نامعتبر رد شد)." : "."), false);
        }
        catch (Exception ex)
        {
            SetStatus("خطا در خواندن پوشه: " + ex.Message, true);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectLecture(Lecture lecture)
    {
        activeLectureId = lecture.Id;
        segments = lecture.Segments;
        activeId = -1;
        await JS.InvokeVoidAsync("lectureSync.setAudioSrc", "audioPlayer", lecture.AudioUrl);
    }

    private static List<Segment> ParseTimedText(string text)
    {
        var result = new List<Segment>();
        int id = 0;
        foreach (var raw in text.Replace("\r\n", "\n").Split('\n'))
        {
            var line = raw.Trim().TrimStart('\uFEFF');
            if (line.Length == 0) continue;
            var m = LineRegex.Match(line);
            if (!m.Success) continue;
            result.Add(new Segment(id++,
                ParseTimeToSeconds(m.Groups[1].Value),
                ParseTimeToSeconds(m.Groups[2].Value),
                m.Groups[3].Value.Trim()));
        }
        return result;
    }

    private static double ParseTimeToSeconds(string t)
    {
        double seconds = 0;
        foreach (var part in t.Split(':')) seconds = seconds * 60 + int.Parse(part);
        return seconds;
    }

    private async Task OnSegmentClick(Segment s)
    {
        await JS.InvokeVoidAsync("lectureSync.seekTo", "audioPlayer", s.Start, true);
        activeId = s.Id;
    }

    [JSInvokable]
    public void OnTimeUpdate(double currentTime)
    {
        var match = segments.LastOrDefault(s => s.Start <= currentTime);
        var newId = match?.Id ?? -1;
        if (newId != activeId)
        {
            activeId = newId;
            InvokeAsync(StateHasChanged);
            if (newId >= 0)
            {
                _ = JS.InvokeVoidAsync("lectureSync.scrollToActive");
            }
        }
    }

    private void SetStatus(string msg, bool error) { statusMessage = msg; isError = error; }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
        await Task.CompletedTask;
    }

    private record Segment(int Id, double Start, double End, string Text);
    private record Lecture(int Id, string Title, string AudioUrl, List<Segment> Segments);

    private class FolderLecture
    {
        public string Title { get; set; } = "";
        public string? AudioUrl { get; set; }
        public string? Text { get; set; }
    }
}
